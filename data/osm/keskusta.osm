  <tag k="description" v="A monument designed to memorate the fallen soldiers of the Finnish Civil War of 1918. Monument by Erik Bryggman and Elias Ilkka, 1920."/>
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="Kaunis on Isänmaa, Elo kuolo sun kasvojes eessä, Helppo nukkua on, Mullassa maan vapahan. Fallna för Finland sönerna slumra, Lugnt i den friköpta, Fädernejorden. Kiitollisuudella Helsingin kaupungilta. Med tacksamhet av Helsingfors stad. Kaatuivat Helsing"/>
  <tag k="memorial" v="grave"/>
  <tag k="name" v="Suomalaisten sotilaiden hauta"/>
  <tag k="name:en" v="Finnish Soldiers' Grave"/>
  <tag k="name:fi" v="Suomalaisten sotilaiden hauta"/>
  <tag k="name:sv" v="De finländska soldaternas grav"/>
  <tag k="note" v="Koko teksti ei mahdu, myös kuolleiden nimiä"/>
  <tag k="website" v="https://www.hamhelsinki.fi/veistos/suomalaisten-sotilaiden-hauta/"/>
  <tag k="wikidata" v="Q105621273"/>
 </node>
