  <tag k="memorial:conflict" v="Winter_War;Continuation_War"/>
  <tag k="name" v="Katkaistu elämä, Sankarihauta"/>
  <tag k="name:en" v="Life Cut Short, War grave"/>
  <tag k="name:fi" v="Katkaistu elämä, Sankarihauta"/>
  <tag k="name:sv" v="Det avbrutna livet, Hjältegrav"/>
